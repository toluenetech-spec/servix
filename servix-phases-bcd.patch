+      </div>
+
+      <Field
+        label="Short description"
+        required
+        error={errors.shortDescription}
+        hint="Shown on service cards (20–200 characters)."
+      >
+        {(props) => (
+          <textarea
+            {...props}
+            className="textarea"
+            rows={2}
+            value={values.shortDescription}
+            onChange={(e) => setValues((v) => ({ ...v, shortDescription: e.target.value }))}
