diff --git a/api/prisma/schema.prisma b/api/prisma/schema.prisma
new file mode 100644
index 0000000..6ef0f3e
--- /dev/null
+++ b/api/prisma/schema.prisma
@@ -0,0 +1,310 @@
+// SERVIX — Phase A catalogue + Phase B accounts/authentication.
+// Money as bigint minor units. Slugs are the public IDs used by frontend URLs.
+
+generator client {
+  provider = "prisma-client"
+  output   = "../src/generated/prisma"
+}
+
+datasource db {
+  provider = "postgresql"
+}
+
+enum VerificationStatus {
+  unverified
+  pending
+  verified
+  rejected
+}
+
+enum AvailabilityState {
+  available
+  limited
+  unavailable
+}
+
+enum ServiceStatus {
+  draft
+  pending_review
+  active
+  paused
+  archived
+}
+
+/* ===================== Phase B: identity ===================== */
+
+enum UserRole {
+  customer
+  professional
+  admin
+}
+
+enum UserStatus {
+  pending_verification
+  active
+  suspended
+  deactivated
+}
+
+model User {
+  id              String     @id @default(uuid())
+  email           String     @unique
+  passwordHash    String     @map("password_hash")
+  fullName        String     @map("full_name")
+  role            UserRole   @default(customer)
+  status          UserStatus @default(pending_verification)
+  emailVerifiedAt DateTime?  @map("email_verified_at")
+  lastLoginAt     DateTime?  @map("last_login_at")
+  createdAt       DateTime   @default(now()) @map("created_at")
+  updatedAt       DateTime   @updatedAt @map("updated_at")
+  deletedAt       DateTime?  @map("deleted_at")
+
+  refreshTokens RefreshToken[]
+  oneTimeTokens OneTimeToken[]
+
+  @@map("users")
+}
+
+model RefreshToken {
+  id        String    @id @default(uuid())
+  userId    String    @map("user_id")
+  tokenHash String    @map("token_hash")
+  familyId  String    @map("family_id")
+  expiresAt DateTime  @map("expires_at")
+  revokedAt DateTime? @map("revoked_at")
+  userAgent String?   @map("user_agent")
+  createdAt DateTime  @default(now()) @map("created_at")
+
+  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  @@index([userId, familyId])
+  @@index([tokenHash])
+  @@map("refresh_tokens")
+}
+
+model OneTimeToken {
+  id        String    @id @default(uuid())
+  userId    String    @map("user_id")
+  purpose   String // 'verify_email' | 'reset_password'
+  tokenHash String    @map("token_hash")
+  expiresAt DateTime  @map("expires_at")
+  usedAt    DateTime? @map("used_at")
+  createdAt DateTime  @default(now()) @map("created_at")
+
+  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  @@index([tokenHash])
+  @@index([userId, purpose])
+  @@map("one_time_tokens")
+}
+
+/* ===================== Phase A: catalogue ===================== */
+
+model Category {
+  id           String   @id @default(uuid())
+  slug         String   @unique
+  name         String
+  description  String?
+  icon         String?
+  serviceCount Int      @default(0) @map("service_count")
+  position     Int      @default(0)
+  isActive     Boolean  @default(true) @map("is_active")
+  createdAt    DateTime @default(now()) @map("created_at")
+  updatedAt    DateTime @updatedAt @map("updated_at")
+
+  services      Service[]
+  professionals ProfessionalProfile[]
+
+  @@map("categories")
+}
+
+model ProfessionalProfile {
+  id                String             @id @default(uuid())
+  slug              String             @unique
+  name              String
+  title             String
+  about             String?
+  locationCity      String?            @map("location_city")
+  locationCountry   String             @default("NG") @map("location_country")
+  categoryId        String?            @map("category_id")
+  verification      VerificationStatus @default(unverified)
+  availability      AvailabilityState  @default(available)
+  responseTimeLabel String?            @map("response_time_label")
+  memberSince       String?            @map("member_since")
+  imageUrl          String?            @map("image_url")
+  ratingAvg         Decimal            @default(0) @map("rating_avg") @db.Decimal(3, 2)
+  reviewCount       Int                @default(0) @map("review_count")
+  completedProjects Int                @default(0) @map("completed_projects")
+  startingPrice     BigInt?            @map("starting_price")
+  currency          String             @default("NGN")
+  createdAt         DateTime           @default(now()) @map("created_at")
+  updatedAt         DateTime           @updatedAt @map("updated_at")
+
+  category  Category?           @relation(fields: [categoryId], references: [id])
+  skills    ProfessionalSkill[]
+  portfolio PortfolioItem[]
+  services  Service[]
+  reviews   Review[]
+
+  @@index([categoryId, verification, availability])
+  @@map("professional_profiles")
+}
+
+model ProfessionalSkill {
+  professionalId String @map("professional_id")
+  skill          String
+  position       Int    @default(0)
+
+  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
+
+  @@id([professionalId, skill])
+  @@map("professional_skills")
+}
+
+model PortfolioItem {
+  id             String  @id @default(uuid())
+  professionalId String  @map("professional_id")
+  title          String
+  category       String?
+  description    String?
+  mediaUrl       String? @map("media_url")
+  position       Int     @default(0)
+
+  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
+
+  @@index([professionalId])
+  @@map("portfolio_items")
+}
+
+model Service {
+  id               String            @id @default(uuid())
+  slug             String            @unique
+  professionalId   String            @map("professional_id")
+  categoryId       String            @map("category_id")
+  title            String
+  shortDescription String            @map("short_description")
+  description      String
+  price            BigInt
+  currency         String            @default("NGN")
+  priceUnit        String            @default("per project") @map("price_unit")
+  durationLabel    String?           @map("duration_label")
+  locationLabel    String?           @map("location_label")
+  isRemote         Boolean           @default(true) @map("is_remote")
+  availability     AvailabilityState @default(available)
+  status           ServiceStatus     @default(active)
+  included         Json              @default("[]")
+  requirements     Json              @default("[]")
+  ratingAvg        Decimal           @default(0) @map("rating_avg") @db.Decimal(3, 2)
+  reviewCount      Int               @default(0) @map("review_count")
+  createdAt        DateTime          @default(now()) @map("created_at")
+  updatedAt        DateTime          @updatedAt @map("updated_at")
+
+  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
+  category     Category            @relation(fields: [categoryId], references: [id])
+  media        ServiceMedia[]
+  faqs         ServiceFaq[]
+  reviews      Review[]
+
+  @@index([categoryId, status, price])
+  @@index([professionalId, status])
+  @@map("services")
+}
+
+model ServiceMedia {
+  id        String  @id @default(uuid())
+  serviceId String  @map("service_id")
+  url       String
+  altText   String? @map("alt_text")
+  position  Int     @default(0)
+  isCover   Boolean @default(false) @map("is_cover")
+
+  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
+
+  @@index([serviceId])
+  @@map("service_media")
+}
+
+model ServiceFaq {
+  id        String @id @default(uuid())
+  serviceId String @map("service_id")
+  question  String
+  answer    String
+  position  Int    @default(0)
+
+  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
+
+  @@index([serviceId])
+  @@map("service_faqs")
+}
+
+model Review {
+  id             String   @id @default(uuid())
+  serviceId      String   @map("service_id")
+  professionalId String   @map("professional_id")
+  author         String
+  rating         Int
+  text           String?
+  isPublished    Boolean  @default(true) @map("is_published")
+  reviewedAt     DateTime @map("reviewed_at")
+  createdAt      DateTime @default(now()) @map("created_at")
+
+  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
+  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
+
+  @@index([serviceId, isPublished, reviewedAt(sort: Desc)])
+  @@index([professionalId, isPublished, reviewedAt(sort: Desc)])
+  @@map("reviews")
+}
+
+model Testimonial {
+  id          String  @id @default(uuid())
+  quote       String
+  author      String
+  role        String?
+  isDemo      Boolean @default(false) @map("is_demo")
+  isPublished Boolean @default(true) @map("is_published")
+  position    Int     @default(0)
+
+  @@map("testimonials")
+}
+
+model Plan {
+  id          String  @id @default(uuid())
+  slug        String  @unique
+  name        String
+  tagline     String?
+  price       BigInt  @default(0)
+  currency    String  @default("NGN")
+  period      String  @default("per month")
+  cta         String  @default("Get Started")
+  highlighted Boolean @default(false)
+  features    Json    @default("[]")
+  isActive    Boolean @default(true) @map("is_active")
+  position    Int     @default(0)
+
+  @@map("plans")
+}
+
+model Faq {
+  id          String  @id @default(uuid())
+  context     String
+  question    String
+  answer      String
+  position    Int     @default(0)
+  isPublished Boolean @default(true) @map("is_published")
+
+  @@index([context, isPublished, position])
+  @@map("faqs")
+}
+
+model ContactMessage {
+  id        String   @id @default(uuid())
+  name      String
+  email     String
+  subject   String
+  message   String
+  status    String   @default("new")
+  createdAt DateTime @default(now()) @map("created_at")
+
+  @@map("contact_messages")
+}
