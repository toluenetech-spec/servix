+export async function submitContact(payload) {
+  const res = await fetch(`${V1}/contact`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(payload),
+  });
+  if (!res.ok) throw await toApiError(res);
+  return res.json();
+}
