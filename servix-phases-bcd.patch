+
+# HTTP server
+PORT=8080
+HOST=0.0.0.0
+
+# Allowed CORS origins (comma-separated). servix*.vercel.app previews are
+# always allowed in addition to this list.
+CORS_ORIGINS="https://servix-two.vercel.app,https://servix-toluenetech.vercel.app,http://localhost:5173"
+
+# --- Phase B: authentication ---
+# HMAC secret for access tokens (JWT HS256). MUST be long and random in
+# production: `openssl rand -hex 64`
+AUTH_JWT_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
+# Access token lifetime (minutes) and refresh token lifetime (days)
+AUTH_ACCESS_TTL_MIN=15
+AUTH_REFRESH_TTL_DAYS=30
+# Frontend base URL used in verification / reset links
+APP_BASE_URL="http://localhost:5173"
+# Email delivery: "console" logs links to stdout (dev); a real provider
+# (Resend/SES) is a deployment configuration for later.
+EMAIL_MODE=console
+
+NODE_ENV=development
