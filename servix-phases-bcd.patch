+              <div style={{ minWidth: '16rem', flex: 1 }}>
+                <div style={{ display: 'flex', gap: 'var(--space-2)', alignItems: 'center', marginBottom: 'var(--space-2)' }}>
+                  <Badge variant={s.status === 'active' ? 'brand' : 'outline'}>
