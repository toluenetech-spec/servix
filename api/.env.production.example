# SERVIX API — production environment template for blitz.cloud
#
# Copy these names into blitz.cloud's environment-variable settings.
# Never commit real credentials. Do not include quotes in dashboard values.

# ---------- Runtime / public origins ----------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Public Vercel frontend. Used in email links and payment redirects.
APP_BASE_URL=https://servix.name.ng
# Public API address assigned by Blitz, or your API custom domain later.
API_BASE_URL=https://REPLACE_WITH_ASSIGNED_BLITZ_HOST
# Comma-separated exact browser origins allowed to call the API.
CORS_ORIGINS=https://servix.name.ng,https://www.servix.name.ng,https://servix-two.vercel.app

# ---------- Neon PostgreSQL ----------
# Keep sslmode=require (or verify-full if your driver/CA setup supports it).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Conservative pool size for a small container + Neon pooler.
PG_POOL_MAX=5

# ---------- Authentication ----------
# Required in production; generate a fresh value: openssl rand -hex 32
AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30
# Optional performance control. 17 is the strongest/current default;
# 15 is ~4x faster on low-CPU free containers. Existing hashes remain valid.
SCRYPT_LOG2_N=15

# ---------- Admin bootstrap ----------
# Idempotent at boot. Password is used only if the account does not exist.
ADMIN_EMAIL=admin@servix.name.ng
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_12_PLUS_CHARACTER_PASSWORD

# ---------- Paystack (keep TEST keys until end-to-end verification) ----------
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
# Do NOT set PAYMENT_MODE=sandbox when testing real Paystack TEST checkout.
PLATFORM_FEE_PCT=10
CONFIRM_WINDOW_DAYS=3
REFUND_BEFORE_WORK_PCT=100

# ---------- Brevo transactional email ----------
EMAIL_MODE=brevo
BREVO_API_KEY=REPLACE_ME
EMAIL_FROM_NAME=Servix
# Must be a sender/domain verified in Brevo.
EMAIL_FROM_EMAIL=no-reply@servix.name.ng

# ---------- Cloudflare R2 via the existing S3-compatible provider ----------
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=servix-storage
STORAGE_S3_ACCESS_KEY_ID=REPLACE_ME
STORAGE_S3_SECRET_ACCESS_KEY=REPLACE_ME
# Public R2 custom domain or r2.dev URL; required by the production gate.
STORAGE_PUBLIC_BASE_URL=https://media.servix.name.ng

# ---------- Existing PostgreSQL-backed worker ----------
# Leave unset/inline on Blitz so the API container also processes queued jobs.
WORKER_MODE=inline
# REDIS_URL intentionally omitted: Servix currently ships PgQueue.
