/* ---------------- Next-gen marketplace (additive, 20261003000000) ---------------- */

/// Earned automatically by lib/achievements.ts rules; never set from the client.
model ProfessionalAchievement {
  id             String              @id @default(uuid())
  professionalId String              @map("professional_id")
  slug           String
  earnedAt       DateTime            @default(now()) @map("earned_at")
  evidence       Json                @default("{}")
  revokedAt      DateTime?           @map("revoked_at")
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, slug])
  @@index([slug])
  @@map("professional_achievements")
}

/// Privacy-safe daily counters (no visitor identity) for profile/service views.
model ViewCounter {
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  day        DateTime @db.Date
  count      Int      @default(0)

  @@id([entityType, entityId, day])
  @@map("view_counters")
}

enum RequestStatus {
  draft
  open
  paused
  closed
  awarded
  cancelled
}

enum BudgetType {
  fixed
  range
}

enum ProposalStatus {
  submitted
  withdrawn
  rejected
  accepted
}

model ServiceRequest {
  id                  String        @id @default(uuid())
  customerId          String        @map("customer_id")
  title               String
  categoryId          String        @map("category_id")
  description         String        @default("")
  budgetType          BudgetType    @default(fixed) @map("budget_type")
  budgetMinKobo       BigInt?       @map("budget_min_kobo")
  budgetMaxKobo       BigInt?       @map("budget_max_kobo")
  deadlineAt          DateTime?     @map("deadline_at")
  preferredDeliveryAt DateTime?     @map("preferred_delivery_at")
  isRemote            Boolean       @default(true) @map("is_remote")
  location            String?
  requiredSkills      Json          @default("[]") @map("required_skills")
  attachments         Json          @default("[]")
  extraRequirements   String?       @map("extra_requirements")
  status              RequestStatus @default(draft)
  awardedProposalId   String?       @map("awarded_proposal_id")
  proposalCount       Int           @default(0) @map("proposal_count")
  publishedAt         DateTime?     @map("published_at")
  closedAt            DateTime?     @map("closed_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  customer            User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category            Category      @relation(fields: [categoryId], references: [id])
  proposals           Proposal[]

  @@index([status, publishedAt])
  @@index([customerId, status])
  @@index([categoryId, status])
  @@map("service_requests")
}

model Proposal {
  id              String              @id @default(uuid())
  requestId       String              @map("request_id")
  professionalId  String              @map("professional_id")
  serviceId       String?             @map("service_id")
  cover           String
  priceKobo       BigInt              @map("price_kobo")
  deliveryDays    Int                 @map("delivery_days")
  milestones      Json                @default("[]")
  attachments     Json                @default("[]")
  proposedStartAt DateTime?           @map("proposed_start_at")
  status          ProposalStatus      @default(submitted)
  rejectedReason  String?             @map("rejected_reason")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  request         ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service         Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  booking         Booking?

  @@index([requestId, status])
  @@index([professionalId, status])
  @@map("proposals")
}
