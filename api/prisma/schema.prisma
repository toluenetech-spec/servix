// SERVIX — Phases A–E.
// Money as bigint minor units. Slugs are the public IDs used by frontend URLs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum AvailabilityState {
  available
  limited
  unavailable
}

enum ServiceStatus {
  draft
  pending_review
  active
  paused
  archived
}

/* ===================== Phase B: identity ===================== */

enum UserRole {
  customer
  professional
  admin
}

/** Manual KYC (identity verification). */
enum KycDocumentType {
  nin_slip
  international_passport
  voters_card
  drivers_license
}

enum KycStatus {
  not_submitted
  pending
  approved
  rejected
}

enum UserKycStatus {
  unverified
  pending
  verified
  rejected
}

enum UserStatus {
  pending_verification
  active
  suspended
  deactivated
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  avatarUrl       String?    @map("avatar_url")
  kycStatus       UserKycStatus @default(unverified) @map("kyc_status")
  role            UserRole   @default(customer)
  status          UserStatus @default(pending_verification)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  sentConnections CommunityConnection[] @relation("connection_sender")
  receivedConnections CommunityConnection[] @relation("connection_recipient")
  threadsA ChatThread[] @relation("thread_a")
  threadsB ChatThread[] @relation("thread_b")
  chatMessages ChatMessage[]
  notifications Notification[]
  sentBroadcasts NotificationBroadcast[]
  savedProfessionals SavedProfessional[]

  authVersion Int @default(0) @map("auth_version")
  oauthIdentities OAuthIdentity[]
  security AccountSecurity?
  securityFlows SecurityFlow[]
  passkeys PasskeyCredential[]
  recoveryCodes RecoveryCode[]
  emailVerificationOtp EmailVerificationOtp?
  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  applications  ProfessionalApplication[]
  professionalProfile ProfessionalProfile?
  bookings      Booking[] @relation("customerBookings")
  auditEntries  AuditLog[]
  kyc           KycVerification? @relation("kyc_subject")
  kycReviews    KycVerification[] @relation("kyc_reviewer")
  serviceRequests ServiceRequest[]

  @@map("users")
}

/**
 * One identity-verification record per user. ID numbers are encrypted at rest
 * (AES-256-GCM via AUTH_SECURITY_SECRET) plus an HMAC digest for duplicate
 * detection; files live under private object-storage keys that are only ever
 * exposed through short-lived signed URLs to admins.
 */
model KycVerification {
  id                String          @id @default(uuid())
  userId            String          @unique @map("user_id")
  user              User            @relation("kyc_subject", fields: [userId], references: [id], onDelete: Cascade)
  documentType      KycDocumentType @map("document_type")
  idNumberEncrypted String          @map("id_number_encrypted")
  idNumberDigest    String          @map("id_number_digest")
  dateOfBirth       DateTime?       @map("date_of_birth") @db.Date
  phone             String?
  documentFileKey   String          @map("document_file_key")
  selfieFileKey     String          @map("selfie_file_key")
  status            KycStatus       @default(pending)
  rejectionReason   String?         @map("rejection_reason")
  reviewedById      String?         @map("reviewed_by")
  reviewedBy        User?           @relation("kyc_reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?       @map("reviewed_at")
  consentAt         DateTime        @map("consent_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([idNumberDigest])
  @@map("kyc_verifications")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id")
  mfaVerified Boolean @default(false) @map("mfa_verified")
  authVersion Int @default(0) @map("auth_version")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  purpose   String // 'verify_email' | 'reset_password'
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, purpose])
  @@map("one_time_tokens")
}

/* ===================== Phase C: professional onboarding ===================== */

enum ApplicationStatus {
  pending
  under_review
  approved
  rejected
}

model ProfessionalApplication {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  status          ApplicationStatus @default(pending)
  title           String
  about           String?
  locationCity    String?           @map("location_city")
  categorySlug    String?           @map("category_slug")
  skills          Json              @default("[]")
  portfolio       Json              @default("[]")
  details         Json              @default("{}")
  photoUrl        String?           @map("photo_url")
  resumeUrl       String?           @map("resume_url")
  resumeFileName  String?           @map("resume_file_name")
  submittedAt     DateTime?         @map("submitted_at")
  reviewedAt      DateTime?         @map("reviewed_at")
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("professional_applications")
}

/* ===================== Phase D: bookings & payments ===================== */

enum BookingStatus {
  pending_payment
  requested
  accepted
  in_progress
  delivered
  completed
  declined
  cancelled
  disputed
  refunded
}

enum PaymentStatus {
  initiated
  captured
  failed
  refunded
}

enum PayoutStatus {
  processing
  paid
  failed
}

enum LedgerAccount {
  provider_cash
  customer_escrow
  professional_payable
  platform_revenue
  refunds_paid
}

model Booking {
  id              String        @id @default(uuid())
  reference       String        @unique
  customerId      String        @map("customer_id")
  professionalId  String        @map("professional_id")
  serviceId       String        @map("service_id")
  status          BookingStatus @default(pending_payment)
  scheduledAt     DateTime      @map("scheduled_at")
  // Immutable price snapshot (kobo) taken at creation:
  amountKobo      BigInt        @map("amount_kobo")
  platformFeeKobo BigInt        @map("platform_fee_kobo")
  currency        String        @default("NGN")
  serviceTitle    String        @map("service_title")
  priceUnit       String        @map("price_unit")
  notes           String?
  idempotencyKey  String?       @map("idempotency_key")
  cancelledBy     String?       @map("cancelled_by") // 'customer' | 'professional'
  cancelReason    String?       @map("cancel_reason")
  disputeReason   String?       @map("dispute_reason")
  disputedAt      DateTime?     @map("disputed_at")
  deliveredAt     DateTime?     @map("delivered_at")
  completedAt     DateTime?     @map("completed_at")
  autoConfirmed   Boolean       @default(false) @map("auto_confirmed")
  expectedDeliveryAt DateTime?  @map("expected_delivery_at")
  deadlineChangedAt  DateTime?  @map("deadline_changed_at")
  rebookedFromId     String?    @map("rebooked_from_id")
  proposalId         String?    @unique @map("proposal_id")
  proposal           Proposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  verifiedPortfolio  PortfolioItem?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  chatThread ChatThread?
  customer     User                @relation("customerBookings", fields: [customerId], references: [id])
  professional ProfessionalProfile @relation("proBookings", fields: [professionalId], references: [id])
  service      Service             @relation(fields: [serviceId], references: [id])
  payments     Payment[]
  events       BookingEvent[]
  review       Review?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, status])
  @@index([professionalId, status, scheduledAt])
  @@index([status, deliveredAt])
  @@map("bookings")
}

model BookingEvent {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  actorId   String?  @map("actor_id") // null = system
  event     String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String        @map("booking_id")
  provider    String        @default("paystack")
  reference   String        @unique
  status      PaymentStatus @default(initiated)
  amountKobo  BigInt        @map("amount_kobo")
  currency    String        @default("NGN")
  verifiedAt  DateTime?     @map("verified_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  providerId  String    @map("provider_id")
  type        String
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@map("webhook_events")
}

model LedgerEntry {
  id         String        @id @default(uuid())
  txnId      String        @map("txn_id")
  bookingId  String?       @map("booking_id")
  paymentId  String?       @map("payment_id")
  payoutId   String?       @map("payout_id")
  // professional_payable entries carry the owning professional:
  subjectId  String?       @map("subject_id")
  account    LedgerAccount
  direction  String // 'debit' | 'credit'
  amountKobo BigInt        @map("amount_kobo")
  currency   String        @default("NGN")
  memo       String?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([txnId])
  @@index([account, subjectId])
  @@index([bookingId])
  @@map("ledger_entries")
}

model Payout {
  id             String       @id @default(uuid())
  professionalId String       @map("professional_id")
  reference      String       @unique
  amountKobo     BigInt       @map("amount_kobo")
  currency       String       @default("NGN")
  status         PayoutStatus @default(processing)
  providerRef    String?      @map("provider_ref")
  createdAt      DateTime     @default(now()) @map("created_at")
  paidAt         DateTime?    @map("paid_at")

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId, status])
  @@map("payouts")
}

model AvailabilityRule {
  id             String @id @default(uuid())
  professionalId String @map("professional_id")
  weekday        Int // 0=Sunday … 6=Saturday
  startHour      Int    @map("start_hour")
  endHour        Int    @map("end_hour")

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id             String   @id @default(uuid())
  professionalId String   @map("professional_id")
  date           DateTime @db.Date
  reason         String?

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, date])
  @@map("availability_exceptions")
}

/* ===================== Phase E: administration & jobs ===================== */

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  data      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

model Job {
  id           String    @id @default(uuid())
  queue        String
  name         String
  payload      Json      @default("{}")
  idempotencyKey String? @map("idempotency_key")
  status       String    @default("pending") // pending | running | done | failed | dead
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5) @map("max_attempts")
  runAt        DateTime  @default(now()) @map("run_at")
  lockedAt     DateTime? @map("locked_at")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([queue, idempotencyKey])
  @@index([status, runAt])
  @@map("jobs")
}

/* ===================== Phase A: catalogue ===================== */

model Category {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String?
  icon         String?
  serviceCount Int      @default(0) @map("service_count")
  position     Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  services      Service[]
  professionals ProfessionalProfile[]

  @@map("categories")
  serviceRequests ServiceRequest[]
}

model ProfessionalProfile {
  id                String             @id @default(uuid())
  userId            String?            @unique @map("user_id")
  slug              String             @unique
  name              String
  title             String
  about             String?
  locationCity      String?            @map("location_city")
  locationCountry   String             @default("NG") @map("location_country")
  categoryId        String?            @map("category_id")
  verification      VerificationStatus @default(unverified)
  availability      AvailabilityState  @default(available)
  responseTimeLabel String?            @map("response_time_label")
  memberSince       String?            @map("member_since")
  imageUrl          String?            @map("image_url")
  ratingAvg         Decimal            @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount       Int                @default(0) @map("review_count")
  completedProjects Int                @default(0) @map("completed_projects")
  startingPrice     BigInt?            @map("starting_price")
  currency          String             @default("NGN")
  planSlug          String             @default("free") @map("plan_slug")
  planExpiresAt     DateTime?          @map("plan_expires_at")
  details           Json               @default("{}")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  subscriptions PlanSubscription[]
  savedBy       SavedProfessional[]
  user      User?               @relation(fields: [userId], references: [id])
  category  Category?           @relation(fields: [categoryId], references: [id])
  skills    ProfessionalSkill[]
  portfolio PortfolioItem[]
  services  Service[]
  reviews   Review[]
  bookings  Booking[] @relation("proBookings")
  payouts   Payout[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  achievements      ProfessionalAchievement[]
  proposals         Proposal[]

  @@index([categoryId, verification, availability])
  @@map("professional_profiles")
}

model ProfessionalSkill {
  professionalId String @map("professional_id")
  skill          String
  position       Int    @default(0)

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([professionalId, skill])
  @@map("professional_skills")
}

model PortfolioItem {
  id             String  @id @default(uuid())
  professionalId String  @map("professional_id")
  title          String
  category       String?
  description    String?
  mediaUrl       String? @map("media_url")
  position       Int     @default(0)

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("portfolio_items")
  bookingId      String?   @unique @map("booking_id")
  verifiedAt     DateTime? @map("verified_at")
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

model Service {
  id               String            @id @default(uuid())
  slug             String            @unique
  professionalId   String            @map("professional_id")
  categoryId       String            @map("category_id")
  title            String
  shortDescription String            @map("short_description")
  description      String
  price            BigInt
  currency         String            @default("NGN")
  priceUnit        String            @default("per project") @map("price_unit")
  durationLabel    String?           @map("duration_label")
  locationLabel    String?           @map("location_label")
  isRemote         Boolean           @default(true) @map("is_remote")
  availability     AvailabilityState @default(available)
  status           ServiceStatus     @default(active)
  included         Json              @default("[]")
  requirements     Json              @default("[]")
  searchTags       Json              @default("[]") @map("search_tags")
  serviceType      String?           @map("service_type")
  deliveryDays     Int?              @map("delivery_days")
  revisions        Int?
  ratingAvg        Decimal           @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount      Int               @default(0) @map("review_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  category     Category            @relation(fields: [categoryId], references: [id])
  media        ServiceMedia[]
  faqs         ServiceFaq[]
  reviews      Review[]
  bookings     Booking[]

  @@index([categoryId, status, price])
  @@index([professionalId, status])
  @@map("services")
  proposals       Proposal[]
}

model ServiceMedia {
  id        String  @id @default(uuid())
  serviceId String  @map("service_id")
  url       String
  altText   String? @map("alt_text")
  kind      String  @default("image")
  fileName  String? @map("file_name")
  position  Int     @default(0)
  isCover   Boolean @default(false) @map("is_cover")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_media")
}

model ServiceFaq {
  id        String @id @default(uuid())
  serviceId String @map("service_id")
  question  String
  answer    String
  position  Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_faqs")
}

model Review {
  id             String   @id @default(uuid())
  bookingId      String?  @unique @map("booking_id")
  serviceId      String   @map("service_id")
  professionalId String   @map("professional_id")
  author         String
  rating         Int
  text           String?
  isPublished    Boolean  @default(true) @map("is_published")
  reviewedAt     DateTime @map("reviewed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  booking      Booking?            @relation(fields: [bookingId], references: [id])

  @@index([serviceId, isPublished, reviewedAt(sort: Desc)])
  @@index([professionalId, isPublished, reviewedAt(sort: Desc)])
  @@map("reviews")
}

model Testimonial {
  id          String  @id @default(uuid())
  quote       String
  author      String
  role        String?
  isDemo      Boolean @default(false) @map("is_demo")
  isPublished Boolean @default(true) @map("is_published")
  position    Int     @default(0)

  @@map("testimonials")
}

model Plan {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  tagline     String?
  price       BigInt  @default(0)
  currency    String  @default("NGN")
  period      String  @default("per month")
  cta         String  @default("Get Started")
  highlighted Boolean @default(false)
  features    Json    @default("[]")
  isActive    Boolean @default(true) @map("is_active")
  position    Int     @default(0)

  @@map("plans")
}

model Faq {
  id          String  @id @default(uuid())
  context     String
  question    String
  answer      String
  position    Int     @default(0)
  isPublished Boolean @default(true) @map("is_published")

  @@index([context, isPublished, position])
  @@map("faqs")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// Additive migration; apply manually only after review. No startup migration.
model EmailVerificationOtp {
  userId       String   @id @map("user_id")
  nonce        String
  digest       String
  expiresAt    DateTime @map("expires_at")
  sentAt       DateTime @map("sent_at")
  windowStart  DateTime @map("window_start")
  sends        Int      @default(1)
  attempts     Int      @default(0)
  usedAt       DateTime? @map("used_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("email_verification_otps")
}


// Security flows are restricted challenges, never application sessions.
model AccountSecurity {
  userId String @id @map("user_id")
  method String? // totp | passkey; null until enrollment proof succeeds
  totpSecret String? @map("totp_secret") // AES-GCM encrypted
  lastTotpStep Int @default(-1) @map("last_totp_step")
  windowStart DateTime @default(now()) @map("window_start")
  failures Int @default(0)
  sends Int @default(0)
  lastSentAt DateTime? @map("last_sent_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("account_security")
}

model SecurityFlow {
  pendingIdentity String? @map("pending_identity")
  id String @id @default(uuid())
  tokenHash String @unique @map("token_hash")
  userId String? @map("user_id")
  purpose String // registration | login | reset
  stage String // email | enroll | factor | recovery | reset_password | complete
  emailDigest String? @map("email_digest")
  emailExpiresAt DateTime? @map("email_expires_at")
  challenge String?
  challengeType String? @map("challenge_type")
  pendingSecret String? @map("pending_secret")
  recoveryEnvelope String? @map("recovery_envelope")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("security_flows")
}

model PasskeyCredential {
  id String @id // base64url credential ID
  userId String @map("user_id")
  publicKey Bytes @map("public_key")
  counter BigInt @default(0)
  transports String[]
  deviceType String @map("device_type")
  backedUp Boolean @map("backed_up")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("passkey_credentials")
}

model RecoveryCode {
  id String @id @default(uuid())
  userId String @map("user_id")
  digest String
  usedAt DateTime? @map("used_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, digest])
  @@map("recovery_codes")
}

// Provider subjects, never email addresses, identify social accounts.
model OAuthIdentity {
  id String @id @default(uuid())
  provider String
  subject String
  userId String @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("oauth_identities")
}

model OAuthAttempt {
  id String @id @default(uuid())
  stateHash String @unique @map("state_hash")
  browserHash String @map("browser_hash")
  provider String
  envelope String?
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("oauth_attempts")
}

model CommunityConnection {
  id String @id @default(uuid())
  pairKey String @unique @map("pair_key")
  requesterId String @map("requester_id")
  recipientId String @map("recipient_id")
  status String @default("pending")
  blockedById String? @map("blocked_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  requester User @relation("connection_sender", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("connection_recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  thread ChatThread?
  @@index([requesterId, status])
  @@index([recipientId, status])
  @@map("community_connections")
}
model ChatThread {
  id String @id @default(uuid())
  participantAId String @map("participant_a_id")
  participantBId String @map("participant_b_id")
  bookingId String? @unique @map("booking_id")
  connectionId String? @unique @map("connection_id")
  readAtA DateTime? @map("read_at_a")
  readAtB DateTime? @map("read_at_b")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  participantA User @relation("thread_a", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User @relation("thread_b", fields: [participantBId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  connection CommunityConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  messages ChatMessage[]
  @@index([participantAId, updatedAt])
  @@index([participantBId, updatedAt])
  @@map("chat_threads")
}
model ChatMessage {
  id String @id @default(uuid())
  threadId String @map("thread_id")
  senderId String @map("sender_id")
  clientId String @map("client_id")
  body String
  createdAt DateTime @default(now()) @map("created_at")
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@unique([senderId, clientId])
  @@index([threadId, createdAt, id])
  @@map("chat_messages")
}

model Notification {
  id String @id @default(uuid())
  userId String @map("user_id")
  type String
  title String
  body String
  link String?
  broadcastId String? @map("broadcast_id")
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}
model NotificationBroadcast {
  id String @id @default(uuid())
  adminId String @map("admin_id")
  audience String
  title String
  body String
  link String?
  recipientCount Int @default(0) @map("recipient_count")
  createdAt DateTime @default(now()) @map("created_at")
  admin User @relation(fields: [adminId], references: [id])
  notifications Notification[]
  @@index([createdAt(sort: Desc)])
  @@map("notification_broadcasts")
}
model PlanSubscription {
  id String @id @default(uuid())
  professionalId String @map("professional_id")
  planSlug String @map("plan_slug")
  status String @default("initiated")
  reference String @unique
  provider String @default("paystack")
  amountKobo BigInt @map("amount_kobo")
  currency String @default("NGN")
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  @@index([professionalId, status])
  @@map("plan_subscriptions")
}
model SavedProfessional {
  id String @id @default(uuid())
  userId String @map("user_id")
  professionalId String @map("professional_id")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  @@unique([userId, professionalId])
  @@map("saved_professionals")
  preferred      Boolean  @default(false)
  note           String?
