# SERVIX API — environment variables. Copy to .env and adjust.

DATABASE_URL="postgresql://servix:servix@127.0.0.1:5432/servix"
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS="https://servix-two.vercel.app,https://servix-toluenetech.vercel.app,http://localhost:5173"

# --- Phase B: authentication ---
AUTH_JWT_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30
APP_BASE_URL="http://localhost:5173"
EMAIL_MODE=console

# --- Phase D: payments ---
# PAYSTACK_SECRET_KEY=sk_live_xxx
# PAYMENT_MODE=sandbox
PLATFORM_FEE_PCT=10
CONFIRM_WINDOW_DAYS=3
REFUND_BEFORE_WORK_PCT=100
API_BASE_URL="http://localhost:8080"

# --- Phase E: admin bootstrap (server-side only; never client-settable) ---
# ADMIN_EMAIL=admin@servix.app
# ADMIN_PASSWORD=change-me-strong-12chars-min

# --- Phase E: Cloudflare R2 (S3-compatible) ---
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=xxx
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_BUCKET=servix-media
# R2_PUBLIC_BASE_URL=https://media.servix.app
# S3-style aliases (equivalent - either set works):
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=servix-storage
# STORAGE_S3_ACCESS_KEY_ID=xxx
# STORAGE_S3_SECRET_ACCESS_KEY=xxx
# STORAGE_PUBLIC_BASE_URL=https://media.servix.app

# --- Email provider (live configuration: Brevo) ---
# EMAIL_MODE selects the transport: console (dev) / noop (tests) / brevo / resend
# EMAIL_PROVIDER is accepted as an alias for EMAIL_MODE.
# EMAIL_MODE=brevo
# BREVO_API_KEY=xkeysib-xxx
# EMAIL_FROM_NAME=Servix
# EMAIL_FROM_EMAIL=you@example.com
# EMAIL_MODE=resend
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="Servix <no-reply@servix.app>"

# --- Phase E: worker / pooling ---
# WORKER_MODE=external
# PG_POOL_MAX=10
# REDIS_URL=redis://localhost:6379   (BullMQ driver — deploy-time swap)

NODE_ENV=development
