# SERVIX API — environment variables. Copy to .env and adjust.

# PostgreSQL connection string
DATABASE_URL="postgresql://servix:servix@127.0.0.1:5432/servix"

# HTTP server
PORT=8080
HOST=0.0.0.0

# Allowed CORS origins (comma-separated). servix*.vercel.app previews are
# always allowed in addition to this list.
CORS_ORIGINS="https://servix-two.vercel.app,https://servix-toluenetech.vercel.app,http://localhost:5173"

# --- Phase B: authentication ---
# HMAC secret for access tokens (JWT HS256). MUST be long and random in
# production: `openssl rand -hex 64`
AUTH_JWT_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
# Access token lifetime (minutes) and refresh token lifetime (days)
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30
# Frontend base URL used in verification / reset links
APP_BASE_URL="http://localhost:5173"
# Email delivery: "console" logs links to stdout (dev); a real provider
# (Resend/SES) is a deployment configuration for later.
EMAIL_MODE=console

NODE_ENV=development

# --- Phase C: internal application review (until the admin dashboard) ---
# Strong random value in production; guards POST /applications/:id/review
SERVIX_REVIEW_KEY="dev-review-key"


# --- Phase D: payments ---
# Real Paystack secret key enables live payments; unset = sandbox provider
# with a signed-webhook local checkout (never fakes success client-side).
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYMENT_MODE=sandbox        # force sandbox even with a key
PLATFORM_FEE_PCT=10
CONFIRM_WINDOW_DAYS=3
REFUND_BEFORE_WORK_PCT=100
API_BASE_URL="http://localhost:8080"
