# SERVIX API — environment variables. Copy to .env and adjust.

DATABASE_URL="postgresql://servix:servix@127.0.0.1:5432/servix"
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS="https://servix-two.vercel.app,https://servix-toluenetech.vercel.app,http://localhost:5173"

# --- Phase B: authentication ---
AUTH_JWT_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30
APP_BASE_URL="http://localhost:5173"
EMAIL_MODE=console

# --- Phase D: payments ---
# PAYSTACK_SECRET_KEY=sk_live_xxx
# PAYMENT_MODE=sandbox
PLATFORM_FEE_PCT=10
CONFIRM_WINDOW_DAYS=3
REFUND_BEFORE_WORK_PCT=100
API_BASE_URL="http://localhost:8080"

# --- Phase E: admin bootstrap (server-side only; never client-settable) ---
# ADMIN_EMAIL=admin@servix.app
# ADMIN_PASSWORD=change-me-strong-12chars-min

# --- Phase E: Cloudflare R2 (S3-compatible) ---
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=xxx
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_BUCKET=servix-media
# R2_PUBLIC_BASE_URL=https://media.servix.app
# S3-style aliases (equivalent - either set works):
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=servix-storage
# STORAGE_S3_ACCESS_KEY_ID=xxx
# STORAGE_S3_SECRET_ACCESS_KEY=xxx
# STORAGE_PUBLIC_BASE_URL=https://media.servix.app

# --- Email provider (live configuration: Brevo) ---
# EMAIL_MODE selects the transport: console (dev) / noop (tests) / brevo / resend
# EMAIL_PROVIDER is accepted as an alias for EMAIL_MODE.
# EMAIL_MODE=brevo
# BREVO_API_KEY=xkeysib-xxx
# EMAIL_FROM_NAME=Servix
# EMAIL_FROM_EMAIL=you@example.com
# EMAIL_MODE=resend
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="Servix <no-reply@servix.app>"

# --- Phase E: worker / pooling ---
# WORKER_MODE=external
# PG_POOL_MAX=10
# REDIS_URL=redis://localhost:6379   (BullMQ driver — deploy-time swap)

NODE_ENV=development

# --- Authentication upgrade: OFF until approved migration + rollout checks ---
AUTH_MFA_ENABLED=false
# Email a user when their account is signed in from a browser/OS it has not used before (in-app notice always). Default on.
LOGIN_ALERTS=true
# Generate a private random secret (>=32 characters), entered in hosting settings.
# Keep stable and backed up; losing/changing it makes encrypted factors unreadable.
# AUTH_SECURITY_SECRET=
AUTH_WEBAUTHN_RP_ID=servix.name.ng
AUTH_WEBAUTHN_ORIGINS=https://servix.name.ng,https://www.servix.name.ng
# Optional standalone registration OTP; MFA takes precedence when enabled.
EMAIL_VERIFICATION_OTP=false
# EMAIL_OTP_SECRET=
# EMAIL_LOGO_URL=https://www.servix.name.ng/brand/servix-email-logo.png

# --- Social sign-in: server-side only, OFF until approved rollout ---
AUTH_OAUTH_ENABLED=false
AUTH_OAUTH_APP_ORIGIN=https://www.servix.name.ng
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=https://api.servix.name.ng/api/v1/auth/google/callback
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=https://api.servix.name.ng/api/v1/auth/github/callback
# Never put client secrets in VITE_* variables or frontend settings.

# Enable only AFTER manually applying the reviewed community migration.
COMMUNITY_ENABLED=false

# ---------------------------------------------------------------------------
# Next-generation marketplace feature flags (all default OFF). Turn each on
# only after the matching migration has been applied manually.
# GET /api/v1/features shows the live snapshot; gated routes answer 503.
REQUESTS_ENABLED=false          # customer requests + proposals (api/docs/MARKETPLACE_REQUESTS.md)
COMPARE_ENABLED=false           # side-by-side comparison (/compare)
TRUST_ENABLED=false             # Trust & performance block (api/docs/TRUST.md)
ACHIEVEMENTS_ENABLED=false      # achievement badges UI (api/docs/ACHIEVEMENTS.md)
PROJECTS_ENABLED=false          # projects & milestones (later block)
CRM_ENABLED=false               # professional CRM (later block)
BUSINESS_ENABLED=false          # business workspace foundation (later block)
PACKAGES_ENABLED=false          # optional service packages (deferred)
PRICING_INSIGHTS_ENABLED=false  # price intelligence (later block)

# ---------------------------------------------------------------------------
# Servix AI (api/docs/AI_ROUTING.md). Default OFF. The API key is a server-side
# secret: set it on the API host only (Railway → Variables); never in the
# frontend, never committed. Provider/model ids are configuration, not code.
AI_ENABLED=false
AI_PROVIDER=dahl                                   # label only — any OpenAI-compatible host works
AI_BASE_URL=https://inference.dahl.global/v1
AI_API_KEY=                                        # required when AI_ENABLED=true (AI stays off without it)
AI_MODEL_DEEPSEEK=deepseek-ai/DeepSeek-V4-Flash-0731   # primary: assistant, matching, radar, profile, pricing, health, explanations
AI_MODEL_MINIMAX=MiniMaxAI/MiniMax-M2.7                # specialist: proposal generation, background drafting
AI_MODEL_GLM=zai-org/GLM-5.3-Flash                     # final fallback
# Optional per-department chain override, e.g. AI_ROUTE_PROPOSAL_GENERATION=deepseek,glm
AI_CALL_TIMEOUT_MS=30000
AI_TASK_TIMEOUT_MS=60000
AI_MAX_ATTEMPTS_PER_MODEL=2
AI_MAX_TOOL_CALLS=6
# Speed: after this many ms without a first token from the current model, the next model in the chain
# is started in parallel and the first usable answer wins (the other call is cancelled). 0 = off.
# On Dahl's free tier the second concurrent call may hit 429 model_concurrency — it simply drops out.
AI_HEDGE_AFTER_MS=6000
# Optional JSON object merged into every chat-completion body (provider-specific knobs, e.g. turning a
# model's reasoning mode off: {"chat_template_kwargs":{"enable_thinking":false}}). Keys are logged, values never.
AI_EXTRA_BODY_JSON=
